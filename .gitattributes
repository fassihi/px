# Text
* text=auto eol=lf
*.cs       text eol=lf diff=csharp
*.shader   text eol=lf
*.hlsl     text eol=lf
*.cginc    text eol=lf
*.md       text eol=lf
*.json     text eol=lf

# Unity YAML. Kept as text so changes can be read and reviewed.
*.meta          text eol=lf
*.unity         text eol=lf
*.prefab        text eol=lf
*.asset         text eol=lf
*.mat           text eol=lf
*.anim          text eol=lf
*.controller    text eol=lf
*.asmdef        text eol=lf
*.inputactions  text eol=lf

# Unity assets that are binary despite the extension
LightingData.asset  filter=lfs diff=lfs merge=lfs -text
*TerrainData.asset  filter=lfs diff=lfs merge=lfs -text

# Images
