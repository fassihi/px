      distance: 16
      fieldOfView: 35
      focusHeight: 1.6
      lookAhead: 2
  - name: 'Arena: pulled back for the fight'
    from: 58
    to: 72
    view:
      yaw: 0
      pitch: 5
      distance: 16
      fieldOfView: 35
      focusHeight: 1.6
      lookAhead: 1
  - name: 'Into depth: behind her, looking down the rail'
    from: 82
    to: 102
    view:
      yaw: 72
      pitch: 18
      distance: 11
      fieldOfView: 50
      focusHeight: 1.6
      lookAhead: 3
  - name: 'Enemy A: back to the side view for the fight'
